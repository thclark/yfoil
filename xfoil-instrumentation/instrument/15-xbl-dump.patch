+          DMASS2 = VDEL(3,1,JV) - DAC*VDEL(3,2,JV)
+          DUEDG2 = UNEW(JBL,IIS) + DAC*U_AC(JBL,IIS) - UEDG(JBL,IIS)
+          DDSTR2 = (DMASS2 - DSTR(JBL,IIS)*DUEDG2)/UEDG(JBL,IIS)
+          IF(JBL.LT.ITRAN(IIS)) DN1X = DCTAU2 / 10.0
+          IF(JBL.GE.ITRAN(IIS)) DN1X = DCTAU2 / CTAU(JBL,IIS)
+          DN2X = DTHET2 / THET(JBL,IIS)
+          DN3X = DDSTR2 / DSTR(JBL,IIS)
+          DN4X = ABS(DUEDG2)/0.25
+          WRITE(96,'(I2,I4,8ES24.16)') IIS, JBL,
+     &      DN1X, DN2X, DN3X, DN4X, DCTAU2, DTHET2, DDSTR2, DUEDG2
+  410   CONTINUE
+   41 CONTINUE
+      CLOSE(96)

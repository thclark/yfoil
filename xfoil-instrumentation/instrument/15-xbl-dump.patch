+      WRITE(93,'(A,2I6)') 'NBL=', NBL(1), NBL(2)
+      WRITE(93,'(A,2I6)') 'IBLTE=', IBLTE(1), IBLTE(2)
+      WRITE(93,'(A,2I6)') 'ITRAN=', ITRAN(1), ITRAN(2)
+      WRITE(93,'(A)') '--- NODES I X Y S NX NY APANEL'
+      DO 10 I=1, N+NW
+        WRITE(93,'(I6,6ES24.16)') I, X(I), Y(I), S(I),

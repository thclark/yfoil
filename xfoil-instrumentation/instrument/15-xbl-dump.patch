+      WRITE(93,'(A,ES24.16)') 'SST_GP=', SST_GP
+      WRITE(93,'(A,ES24.16)') 'ANTE=', ANTE
+      WRITE(93,'(A,ES24.16)') 'ASTE=', ASTE

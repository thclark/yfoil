+      SUBROUTINE RDDUMP(NDUMP, IDUMP)
+C---- INSTRUMENTATION: read the list of SETBL/UPDATE/BLSOLV call numbers to dump from
+C     dump_calls.txt (one integer per line, at most 32); default 1, 2, 3.
+      INTEGER NDUMP, IDUMP(32)
+      LOGICAL LEX
+      INTEGER IOS
+      INQUIRE(FILE='dump_calls.txt', EXIST=LEX)
+      NDUMP = 0
+      IF(LEX) THEN
+       OPEN(73, FILE='dump_calls.txt', STATUS='OLD')
+ 10    CONTINUE
+       IF(NDUMP.GE.32) GO TO 20
+       READ(73,*,IOSTAT=IOS) IDUMP(NDUMP+1)
+       IF(IOS.NE.0) GO TO 20
+       NDUMP = NDUMP + 1
+       GO TO 10
+ 20    CONTINUE
+       CLOSE(73)
+      ELSE
+       NDUMP = 3
+       IDUMP(1) = 1
+       IDUMP(2) = 2
+       IDUMP(3) = 3
+      ENDIF
+      RETURN
+      END
